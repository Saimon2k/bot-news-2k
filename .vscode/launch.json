{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch NewsDigest",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/NewsDigest.App/bin/Debug/net10.0/NewsDigest.App.dll",
            "args": [],
            "cwd": "${workspaceFolder}/NewsDigest.App",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "DOTNET_ENVIRONMENT": "Development",
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Debug NewsDigest",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/NewsDigest.App/bin/Debug/net10.0/NewsDigest.App.dll",
            "args": [],
            "cwd": "${workspaceFolder}/NewsDigest.App",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "DOTNET_ENVIRONMENT": "Development",
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "logging": {
                "moduleLoad": false
            },
            "justMyCode": true,
            "suppressJITOptimizations": true,
            "enableStepFiltering": false
        },
        {
            "name": "Attach to NewsDigest",
            "type": "coreclr",
            "request": "attach",
            "processName": "NewsDigest.App"
        }
    ]
}
